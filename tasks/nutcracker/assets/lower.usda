#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.16

    def Cube "LowerJaw" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Asset/Materials/LowerJaw>
        double size = 1
        float3 xformOp:scale = (0.06, 0.06, 0.008)
        double3 xformOp:translate = (0, 0.045, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Materials"
    {
        def Material "LowerJaw"
        {
            token outputs:surface.connect = </Asset/Materials/LowerJaw/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.91, 0.73, 0.54)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

