#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Cube "WallN1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Asset/Materials/WallN1>
        color3f[] primvars:displayColor = [(0.17, 0.29, 0.4)]
        double size = 1
        float xformOp:rotateZ = 15
        float3 xformOp:scale = (0.18, 0.009, 0.18)
        double3 xformOp:translate = (-0.125, -0.045493649053890334, 0.09)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }

    def "Materials"
    {
        def Material "WallN1"
        {
            token outputs:surface.connect = </Asset/Materials/WallN1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.29, 0.4)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Wall1"
        {
            token outputs:surface.connect = </Asset/Materials/Wall1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.29, 0.4)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Cube "Wall1" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Asset/Materials/Wall1>
        color3f[] primvars:displayColor = [(0.17, 0.29, 0.4)]
        double size = 1
        float xformOp:rotateZ = -15
        float3 xformOp:scale = (0.18, 0.009, 0.18)
        double3 xformOp:translate = (-0.125, 0.045493649053890334, 0.09)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }
}
