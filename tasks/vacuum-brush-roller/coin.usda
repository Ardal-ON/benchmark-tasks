#usda 1.0
(
    defaultPrim = "Coin"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Coin" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.00567

    def "Materials"
    {
        def Material "CoinAlloy"
        {
            token outputs:surface.connect = </Coin/Materials/CoinAlloy/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.54, 0.54, 0.51)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Cylinder "Blank" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.00175
        rel material:binding = </Coin/Materials/CoinAlloy>
        custom float physxCollision:contactOffset = 0.00045
        double radius = 0.01213
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

