#usda 1.0
(
    defaultPrim = "CleanerHead"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CleanerHead"
{
    def Xform "StaticShell"
    {
        def Cube "TopShell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/GraphiteABS>
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.228, 0.106, 0.012)
            double3 xformOp:translate = (0.109, 0.017, -0.032)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cube "LeadingLip" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/GraphiteABS>
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.188, 0.012, 0.044)
            double3 xformOp:translate = (0.129, -0.039, -0.016)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cube "ExtractionSide" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/GraphiteABS>
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.188, 0.015, 0.08)
            double3 xformOp:translate = (0.129, 0.044, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cube "DriveEnd" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/GraphiteABS>
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.048, 0.07, 0.073)
            double3 xformOp:translate = (0.219, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cylinder "WandPort" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double height = 0.052
            rel material:binding = </CleanerHead/Materials/GraphiteABS>
            double radius = 0.022
            double3 xformOp:translate = (0.11, 0.069, -0.01)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "StrikeA" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/LockingABS>
            custom float physxCollision:contactOffset = 0.00045
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.006, 0.015, 0.011)
            double3 xformOp:translate = (0.0015, 0, -0.036)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cube "StrikeB" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/LockingABS>
            custom float physxCollision:contactOffset = 0.00045
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.006, 0.015, 0.011)
            double3 xformOp:translate = (0.0015, 0, 0.036)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }

        def Cube "LockIndex" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </CleanerHead/Materials/Index>
            double size = 1
            float xformOp:rotateX = 0
            float3 xformOp:scale = (0.001, 0.009, 0.006)
            double3 xformOp:translate = (-0.004, -0.02, 0.041)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
        }
    }

    def "Materials"
    {
        def Material "GraphiteABS"
        {
            token outputs:surface.connect = </CleanerHead/Materials/GraphiteABS/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.1, 0.11)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Roller"
        {
            token outputs:surface.connect = </CleanerHead/Materials/Roller/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.18, 0.28)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Bristles"
        {
            token outputs:surface.connect = </CleanerHead/Materials/Bristles/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63, 0.12, 0.035)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "LockingABS"
        {
            token outputs:surface.connect = </CleanerHead/Materials/LockingABS/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.32, 0.36)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Index"
        {
            token outputs:surface.connect = </CleanerHead/Materials/Index/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.77)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }
}

