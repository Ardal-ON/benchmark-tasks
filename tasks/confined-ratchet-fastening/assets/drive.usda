#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.086

    def Xform "DriveVisual" (
        prepend references = @ratchet_visual.usda@</RatchetVisual/Drive>
    )
    {
    }

    def Xform "Socket" (
        apiSchemas = None
        prepend references = @socket.usda@</Asset>
    )
    {
        double3 xformOp:translate = (0, 0, -0.028)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
