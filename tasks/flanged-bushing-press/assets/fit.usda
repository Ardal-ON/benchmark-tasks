    def PhysicsFixedJoint "WorldAnchor" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        rel physics:body1 = </Fit/Housing>
        bool physxArticulation:enabledSelfCollisions = 1
        int physxArticulation:solverPositionIterationCount = 24
        int physxArticulation:solverVelocityIterationCount = 8
    }

    def Material "Steel"
    {
        token outputs:surface.connect = </Fit/Steel/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.34, 0.42, 0.49)
            float inputs:roughness = 0.48
            token outputs:surface
        }
    }

    def Material "Polymer"
    {
        token outputs:surface.connect = </Fit/Polymer/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.76, 0.62, 0.32)
            float inputs:roughness = 0.48
            token outputs:surface
        }
    }

    def PhysicsPrismaticJoint "fit_slide" (
        prepend apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 20
        float drive:linear:physics:maxForce = 35
        float drive:linear:physics:stiffness = 280000
        float drive:linear:physics:targetPosition = 0
        float drive:linear:physics:targetVelocity = 0
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "Z"
        rel physics:body0 = </Fit/Housing>
        rel physics:body1 = </Fit/Bushing>
        bool physics:collisionEnabled = 1
        point3f physics:localPos0 = (0, 0, 0.015)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -0.01525
        float physics:upperLimit = 0
    }
}

