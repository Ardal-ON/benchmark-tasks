                color3f inputs:diffuseColor = (0.88, 0.88, 0.77)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def PhysicsFixedJoint "Anchor" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        rel physics:body1 = </CleanerHead/Head>
        custom bool physxArticulation:enabledSelfCollisions = 1
    }

    def PhysicsPrismaticJoint "roller_slide"
    {
        uniform token physics:axis = "X"
        rel physics:body0 = </CleanerHead/Head>
        rel physics:body1 = </CleanerHead/Roller>
        bool physics:collisionEnabled = 1
        point3f physics:localPos0 = (-0.1, 0, 0)
        float physics:lowerLimit = -0.003
        float physics:upperLimit = 0.1
    }

    def PhysicsRevoluteJoint "cap_turn"
    {
        uniform token physics:axis = "X"
        rel physics:body0 = </CleanerHead/Roller>
        rel physics:body1 = </CleanerHead/Cap>
        bool physics:collisionEnabled = 0
        float physics:lowerLimit = 0
        float physics:upperLimit = 90
    }
}

