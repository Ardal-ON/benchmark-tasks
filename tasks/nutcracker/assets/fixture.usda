#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Cube "Base" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Asset/Materials/Base>
        double size = 1
        float3 xformOp:scale = (0.13, 0.13, 0.012)
        double3 xformOp:translate = (0, 0, 0.006)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Materials"
    {
        def Material "Base"
        {
            token outputs:surface.connect = </Asset/Materials/Base/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.14, 0.1)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }
}

